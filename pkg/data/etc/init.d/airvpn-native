#!/bin/sh /etc/rc.common
START=96
USE_PROCD=1

start_service() {
	[ "$(uci -q get airvpn_native.main.auto_sync)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /bin/sh -c '/usr/bin/airvpn-native sync >/tmp/airvpn-native-sync.log 2>&1 || logger -t airvpn-native "boot sync failed"'
	procd_close_instance
}